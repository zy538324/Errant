    "clsx": "^2.1.1",
    "lucide-react": "^0.488.0",
    "next": "15.5.15",
    "otplib": "^12.0.1",
    "postcss": "^8.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "stripe": "^17.7.0",
    "styled-components": "^6.3.12",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^3.4.17",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
