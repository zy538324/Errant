# To prevent access to .env and other files
<Files .*>
# Apache 2.2
<IfModule !mod_authz_core.c>
Order deny,allow
Deny from all
</IfModule>
# Apache 2.4
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Remove /dir from the path if it exists and rewrite to public
    RewriteCond %{REQUEST_URI} ^/dir/(.*)$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ /dir/public/index.php?$1 [L,QSA]
    
    # Direct access to public folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ /dir/public/index.php [L,QSA]
</IfModule>

<IfModule mod_alias.c>
    RedirectMatch 301 ^/dir/?$ /dir/public/
</IfModule>