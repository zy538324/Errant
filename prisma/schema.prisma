// Errant-Arts data model.
// PostgreSQL (Neon) for production and development.
// Enum-like values are stored as TEXT and validated in the application layer
// (src/lib/enums.ts) for portability.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  username           String              @unique
  passwordHash       String?
  role               String              @default("CUSTOMER") // ADMIN | CUSTOMER
  mfaEnabled         Boolean             @default(false)
  mfaSecret          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  customer           Customer?
  auditLogs          AuditLog[]
  sessions           Session[]
  loginCodes         CustomerLoginCode[]
  blogPosts          BlogPost[]
  marketingCampaigns MarketingCampaign[]
  moderatedReviews   CustomerReview[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model CustomerLoginCode {
  id         String    @id @default(cuid())
  userId     String
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  ipAddress  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([userId, expiresAt])
}

model Customer {
  id               String                  @id @default(cuid())
  userId           String                  @unique
  fullName         String?
  marketingConsent Boolean                 @default(false)
  consentAt        DateTime?
  retentionLocked  Boolean                 @default(false)
  user             User                    @relation(fields: [userId], references: [id])
  orders           Order[]
  entitlements     DownloadEntitlement[]
  printOrders      PrintOrder[]
  emailSubscriber  EmailSubscriber?
  consentEvents    MarketingConsentEvent[]
  reviews          CustomerReview[]
}

model EmailSubscriber {
  id             String                       @id @default(cuid())
  email          String                       @unique
  customerId     String?                      @unique
  status         String                       @default("SUBSCRIBED") // SUBSCRIBED | UNSUBSCRIBED | SUPPRESSED
  consentSource  String?
  consentVersion String?
  consentText    String?
  consentedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  customer       Customer?                    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  consentEvents  MarketingConsentEvent[]
  recipients     MarketingCampaignRecipient[]

  @@index([status, consentedAt])
}

model MarketingConsentEvent {
  id             String           @id @default(cuid())
  subscriberId   String?
  customerId     String?
  email          String
  eventType      String // OPT_IN | UNSUBSCRIBE | SUPPRESS
  source         String
  consentVersion String?
  consentText    String?
  ipAddress      String?
  userAgent      String?
  metadataJson   String?
  createdAt      DateTime         @default(now())
  subscriber     EmailSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([subscriberId, createdAt])
  @@index([customerId, createdAt])
}

model MarketingCampaign {
  id           String                       @id @default(cuid())
  subject      String
  previewText  String?
  bodyText     String
  status       String                       @default("DRAFT") // DRAFT | SENDING | SENT | FAILED
  fromEmail    String
  replyToEmail String
  createdById  String?
  sentAt       DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  createdBy    User?                        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipients   MarketingCampaignRecipient[]

  @@index([status, createdAt])
}

model MarketingCampaignRecipient {
  id           String            @id @default(cuid())
  campaignId   String
  subscriberId String
  email        String
  status       String            @default("PENDING") // PENDING | SENDING | SENT | FAILED | SKIPPED
  messageId    String?
  error        String?
  sentAt       DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  campaign     MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber   EmailSubscriber   @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status])
  @@index([subscriberId, createdAt])
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  coverAsset  String?
  sortOrder   Int       @default(0)
  artworks    Artwork[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Artwork {
  id           String                @id @default(cuid())
  title        String
  slug         String                @unique
  description  String?
  status       String                @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  category     String?
  tagsJson     String                @default("[]")
  pricePence   Int
  currency     String                @default("GBP")
  stockOnHand  Int?
  widthPx      Int?
  heightPx     Int?
  previewUrl   String?
  collectionId String?
  collection   Collection?           @relation(fields: [collectionId], references: [id])
  assets       ArtworkAsset[]
  orderItems   OrderItem[]
  entitlements DownloadEntitlement[]
  printOrders  PrintOrder[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([collectionId, status])
}

model ArtworkAsset {
  id         String   @id @default(cuid())
  artworkId  String
  kind       String // ORIGINAL | PREVIEW | WATERMARKED_PREVIEW | DOWNLOAD_MASTER
  storageKey String   @unique
  mimeType   String
  bytes      Int
  checksum   String?
  artwork    Artwork  @relation(fields: [artworkId], references: [id])
  createdAt  DateTime @default(now())

  @@index([artworkId, kind])
}

model Order {
  id                    String                @id @default(cuid())
  customerId            String
  status                String                @default("PENDING") // PENDING | PAID | FULFILLED | REFUNDED | CANCELLED
  stripeCheckoutId      String?               @unique
  stripePaymentIntentId String?               @unique
  totalPence            Int
  currency              String                @default("GBP")
  customer              Customer              @relation(fields: [customerId], references: [id])
  items                 OrderItem[]
  entitlements          DownloadEntitlement[]
  printOrders           PrintOrder[]
  reviews               CustomerReview[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model CustomerReview {
  id            String    @id @default(cuid())
  customerId    String
  orderId       String?
  displayName   String
  rating        Int
  body          String
  status        String    @default("PENDING")
  denialReason  String?
  submittedAt   DateTime  @default(now())
  approvedAt    DateTime?
  deniedAt      DateTime?
  moderatedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  moderatedBy   User?     @relation(fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([orderId])
  @@index([status, submittedAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  artworkId String
  unitPence Int
  quantity  Int     @default(1)
  kind      String  @default("digital") // "digital" | "print"
  printSku  String?
  order     Order   @relation(fields: [orderId], references: [id])
  artwork   Artwork @relation(fields: [artworkId], references: [id])

  @@index([orderId])
  @@index([artworkId])
}

model DownloadEntitlement {
  id            String    @id @default(cuid())
  customerId    String
  orderId       String
  artworkId     String
  maxDownloads  Int       @default(5)
  downloadCount Int       @default(0)
  expiresAt     DateTime?
  customer      Customer  @relation(fields: [customerId], references: [id])
  order         Order     @relation(fields: [orderId], references: [id])
  artwork       Artwork   @relation(fields: [artworkId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([customerId, orderId])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  status      String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt DateTime?
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  entityType   String
  entityId     String
  metadataJson String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])
}

model PrintOrder {
  id              String   @id @default(cuid())
  orderId         String
  customerId      String
  artworkId       String
  provider        String   @default("printful")
  providerOrderId String?
  sku             String
  variant         String
  quantity        Int      @default(1)
  unitPence       Int
  shipTo          String
  status          String   @default("PENDING") // PENDING | SUBMITTED | PRODUCING | SHIPPED | DELIVERED | CANCELLED | FAILED
  trackingUrl     String?
  providerPayload String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  order           Order    @relation(fields: [orderId], references: [id])
  customer        Customer @relation(fields: [customerId], references: [id])
  artwork         Artwork  @relation(fields: [artworkId], references: [id])

  @@index([orderId])
  @@index([status])
}

model PrintProduct {
  id             String   @id @default(cuid())
  provider       String   @default("printful")
  providerSku    String   @unique
  name           String
  description    String?
  variantsJson   String   @default("[]")
  basePencePrice Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
